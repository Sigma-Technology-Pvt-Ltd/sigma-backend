# Backend Environment Variables
# Copy this file to .env and fill in the values

PORT=3000
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"
FRONTEND_URL="http://localhost:3001"
ADMIN_URL="http://localhost:5173"
TICKETING_URL="http://localhost:5174"
APP_URL="http://localhost:3000"
API_KEY="your_api_key_here"
JWT_SECRET="your_jwt_secret_here"

# Supabase Storage (for image/file uploads)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your_service_role_key_here"
SUPABASE_BUCKET="sigma-media"

# Resend (transactional email) — add API key to activate emails
# Sign up at https://resend.com, verify your domain, then paste key here
RESEND_API_KEY=""
RESEND_FROM="ClaimDesk <noreply@yourdomain.com>"

# Production examples:
# FRONTEND_URL="https://yourdomain.com"
# ADMIN_URL="https://admin.yourdomain.com"
# TICKETING_URL="https://claimdesk.yourdomain.com"
